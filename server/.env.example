PORT=8787
DATABASE_URL=postgresql://postgres:password@localhost:5432/marga_run_club
UI_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Organizer console. Keep this value private; it is sent only in the x-admin-key header.
ADMIN_API_KEY=change-this-local-key

# Razorpay Standard Checkout API (server-only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google OAuth (Google Cloud OAuth client, Web application type).
# Redirect URI is ${AUTH_URL}/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail SMTP with a Google App Password (keep server-only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM=Marga Run Club <your-sender@gmail.com>
